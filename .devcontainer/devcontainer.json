{
  "name": "OCaml Guandan",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Guandan preview" } },
  "customizations": {
    "vscode": {
      "extensions": ["ocamllabs.ocaml-platform", "eamodio.gitlens"]
    }
  }
}
